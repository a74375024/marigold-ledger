-static int tlsEsperar(int fd, int escrever, int ms) {
-  fd_set f;
-  struct timeval tv;
-  if (fd < 0 || fd >= FD_SETSIZE) return -1;
-  FD_ZERO(&f);
-  FD_SET(fd, &f);
-  tv.tv_sec = ms / 1000;
-  tv.tv_usec = (ms % 1000) * 1000;
-  return select(fd + 1, escrever ? NULL : &f, escrever ? &f : NULL, NULL, &tv);
-}
