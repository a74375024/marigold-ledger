-  if (r->body.n + n + 1 > r->body.cap) {
-    size_t cap = r->body.cap ? r->body.cap : 4096;
-    while (cap < r->body.n + n + 1) cap *= 2;
-    if (cap > (size_t)r->limit + 1) cap = (size_t)r->limit + 1;
-    next = realloc(r->body.p, cap);
-    if (!next) return 0;
-    r->body.p = next; r->body.cap = cap;
