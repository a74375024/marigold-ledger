# The channel directory, built into the app as bytes: tools/channeldir
# writes data/channel-directory.json (CI makes it at most weekly). Without
# the file the app has an empty directory, and it never fetches one.
set(MARIGOLD_CHANNEL_DIRECTORY "${CMAKE_SOURCE_DIR}/data/channel-directory.json" CACHE FILEPATH "Built-in channel directory (JSON)")
set(_blob "${CMAKE_BINARY_DIR}/generated/channel_directory_blob.cpp")
set(_bytes "")
set(_size 0)
if(EXISTS "${MARIGOLD_CHANNEL_DIRECTORY}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${MARIGOLD_CHANNEL_DIRECTORY}")
  file(READ "${MARIGOLD_CHANNEL_DIRECTORY}" _hex HEX)
  string(LENGTH "${_hex}" _len)
  math(EXPR _size "${_len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
  message(STATUS "Built-in channel directory: ${MARIGOLD_CHANNEL_DIRECTORY} (${_size} bytes)")
else()
  message(STATUS "Built-in channel directory: none (${MARIGOLD_CHANNEL_DIRECTORY} not found)")
endif()
file(WRITE "${_blob}.new"
  "// Generated by cmake/channel-directory.cmake from data/channel-directory.json.\n"
  "#include <cstddef>\n"
  "extern const unsigned char kMarigoldChannelDirectory[];\n"
  "extern const std::size_t kMarigoldChannelDirectorySize;\n"
  "const unsigned char kMarigoldChannelDirectory[] = {${_bytes}0x00};\n"
  "const std::size_t kMarigoldChannelDirectorySize = ${_size};\n")
configure_file("${_blob}.new" "${_blob}" COPYONLY)
target_sources(marigold_core PRIVATE "${_blob}")
