# Wikipedia's market and station lists, built into the app as bytes:
# tools/wikidata writes data/wiki-data.json (CI fetches it at most weekly).
# Without the file the app has none, and it never fetches them itself.
set(MARIGOLD_WIKI_DATA "${CMAKE_SOURCE_DIR}/data/wiki-data.json" CACHE FILEPATH "Built-in Wikipedia data (JSON)")
set(_blob "${CMAKE_BINARY_DIR}/generated/wiki_data_blob.cpp")
set(_bytes "")
set(_size 0)
if(EXISTS "${MARIGOLD_WIKI_DATA}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${MARIGOLD_WIKI_DATA}")
  file(READ "${MARIGOLD_WIKI_DATA}" _hex HEX)
  string(LENGTH "${_hex}" _len)
  math(EXPR _size "${_len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
  message(STATUS "Built-in Wikipedia data: ${MARIGOLD_WIKI_DATA} (${_size} bytes)")
else()
  message(STATUS "Built-in Wikipedia data: none (${MARIGOLD_WIKI_DATA} not found)")
endif()
file(WRITE "${_blob}.new"
  "// Generated by cmake/wiki-data.cmake from data/wiki-data.json.\n"
  "#include <cstddef>\n"
  "extern const unsigned char kMarigoldWikiData[];\n"
  "extern const std::size_t kMarigoldWikiDataSize;\n"
  "const unsigned char kMarigoldWikiData[] = {${_bytes}0x00};\n"
  "const std::size_t kMarigoldWikiDataSize = ${_size};\n")
configure_file("${_blob}.new" "${_blob}" COPYONLY)
target_sources(marigold_core PRIVATE "${_blob}")
