# Reference data for the lineup, built into the app as bytes from
# data/lineup-reference.bin. Without the file the app has none.
set(MARIGOLD_LINEUP_REFERENCE "${CMAKE_SOURCE_DIR}/data/lineup-reference.bin" CACHE FILEPATH "Built-in lineup reference")
set(_blob "${CMAKE_BINARY_DIR}/generated/lineup_reference_blob.cpp")
set(_bytes "")
set(_size 0)
if(EXISTS "${MARIGOLD_LINEUP_REFERENCE}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${MARIGOLD_LINEUP_REFERENCE}")
  file(READ "${MARIGOLD_LINEUP_REFERENCE}" _hex HEX)
  string(LENGTH "${_hex}" _len)
  math(EXPR _size "${_len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
  message(STATUS "Built-in lineup reference: ${_size} bytes")
else()
  message(STATUS "Built-in lineup reference: none")
endif()
file(WRITE "${_blob}.new"
  "// Generated by cmake/lineup-reference.cmake.\n"
  "#include <cstddef>\n"
  "extern const unsigned char kMarigoldLineupReference[];\n"
  "extern const std::size_t kMarigoldLineupReferenceSize;\n"
  "const unsigned char kMarigoldLineupReference[] = {${_bytes}0x00};\n"
  "const std::size_t kMarigoldLineupReferenceSize = ${_size};\n")
configure_file("${_blob}.new" "${_blob}" COPYONLY)
target_sources(marigold_core PRIVATE "${_blob}")
